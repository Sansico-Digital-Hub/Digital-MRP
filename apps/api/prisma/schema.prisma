// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  PRODUCTION_PLANNER
  MATERIAL_PLANNER
  USER
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(USER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  auditLogs            AuditLog[]
  notifications        Notification[]
  calculationHistories CalculationHistory[]
  fgStocks             FGStock[]
  fgStockHistory       FGStockHistory[]
  wips                 WIP[]
  cycleAuditLogs       CycleAuditLog[]

  @@index([email])
  @@index([role])
  @@map("users")
}

// ============================================
// MASTER DATA
// ============================================

model Item {
  id         String   @id @default(cuid())
  partNumber String   @unique
  itemName   String
  unit       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  dailySchedules  DailySchedule[]
  weeklySchedules WeeklySchedule[]
  fgStocks        FGStock[]
  fgStockHistory  FGStockHistory[]
  wips            WIP[]
  masterCartons   MasterCarton[]

  @@index([partNumber])
  @@index([itemName])
  @@map("items")
}

// Riwayat pergerakan stok barang jadi.
// Model ini sempat hilang dari schema padahal route `fgStockHistory.ts` masih
// memakainya, sehingga build gagal begitu Prisma Client di-generate ulang.
model FGStockHistory {
  id        String   @id @default(cuid())
  itemId    String
  inQty     Float    @default(0)
  outQty    Float    @default(0)
  balance   Float
  type      String
  date      DateTime @db.Date
  notes     String?  @db.Text
  createdBy String
  createdAt DateTime @default(now())

  // Relations
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User @relation(fields: [createdBy], references: [id])

  @@index([itemId])
  @@index([date])
  @@map("fg_stock_history")
}

model MasterCarton {
  id             String   @id @default(cuid())
  cartonCode     String   @unique
  toyNameItemId  String // Reference to Item (Toy Name)
  partNumberCode String // Part number that belongs to this master carton
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  toyNameItem Item @relation(fields: [toyNameItemId], references: [id], onDelete: Cascade)

  @@index([toyNameItemId])
  @@index([partNumberCode])
  @@map("master_cartons")
}

// ============================================
// DEMAND / SCHEDULE
// ============================================

model DailySchedule {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  shift     Int // 1, 2, or 3
  itemId    String
  quantity  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([date, shift, itemId])
  @@index([date, shift])
  @@index([itemId])
  @@map("daily_schedules")
}

model WeeklySchedule {
  id            String     @id @default(cuid())
  periodId      String // periode UPLOAD (bukan tanggal di dalam data)
  // Modul pemilik data. WAJIB: data Production Planning dan Material Planning
  // tidak boleh saling memengaruhi (lihat migrasi 20260929000000_module_type).
  moduleType    DataModule
  year          Int
  weekNumber    Int // 1-26
  weekStartDate DateTime   @db.Date
  weekEndDate   DateTime   @db.Date
  itemId        String
  quantity      Float
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relations
  item   Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  period PlanningCycle @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, moduleType, year, weekNumber, itemId])
  @@index([periodId])
  @@index([periodId, moduleType])
  @@index([periodId, moduleType, year, weekNumber])
  @@index([itemId])
  @@map("weekly_schedules")
}

// ============================================
// STOCK & INVENTORY
// ============================================

model FGStock {
  id        String   @id @default(cuid())
  itemId    String   @unique // Unique karena hanya 1 record per item (overwrite)
  quantity  Float
  date      DateTime @db.Date
  shift     Int? // Optional
  notes     String?  @db.Text
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User @relation(fields: [updatedBy], references: [id])

  @@index([itemId])
  @@index([date])
  @@map("fg_stocks")
}

// ============================================
// WORK IN PROGRESS (WIP)
// ============================================

enum WIPStatus {
  IN_PROGRESS
  ON_HOLD
  DELAYED
  COMPLETED
}

// Pemilik data untuk tabel yang DIPAKAI BERSAMA secara tampilan
// (MRP 26 Weeks, WIP). Setiap baris hanya boleh dibaca/ditulis oleh modul
// pemiliknya, sehingga upload di satu modul tidak pernah mengubah modul lain.
enum DataModule {
  PRODUCTION // Production Planning
  MATERIAL   // Material Planning
}

model WIP {
  id              String    @id @default(cuid())
  periodId        String // periode UPLOAD (bukan tanggal di dalam data)
  // Modul pemilik data (PRODUCTION | MATERIAL). Lihat model WeeklySchedule.
  moduleType      DataModule
  itemId          String
  location        String // Mesin-01, Assembly Line, etc.
  quantity        Float
  progressPercent Int       @default(0) // 0-100
  date            DateTime  @db.Date
  shift           Int // 1, 2, or 3
  status          WIPStatus @default(IN_PROGRESS)
  notes           String?   @db.Text
  updatedBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  item   Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [updatedBy], references: [id])
  period PlanningCycle @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, moduleType, itemId, location]) // Unique per periode + modul + item + location (overwrite)
  @@index([periodId])
  @@index([periodId, moduleType])
  @@index([itemId])
  @@index([location])
  @@index([status])
  @@index([periodId, moduleType, date, shift])
  @@map("wips")
}

// ============================================
// AUDIT LOG
// ============================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String
  action     AuditAction
  entityType String // "FGStock", "WIP", "DailySchedule", etc.
  entityId   String
  dataBefore Json? // Data sebelum perubahan
  dataAfter  Json? // Data setelah perubahan
  notes      String?     @db.Text
  createdAt  DateTime    @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// NOTIFICATIONS
// ============================================

enum NotificationType {
  SHORTAGE
  DELAY
  STALE_DATA
  INFO
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  itemCode  String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================
// HOTLIST
// ============================================

model Hotlist {
  id           String    @id @default(cuid())
  periodId     String // periode UPLOAD (bukan tanggal di dalam data)
  partNumber   String
  date         DateTime  @db.Date
  previousDate DateTime? @db.Date
  biTotal      Float
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  period PlanningCycle @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, partNumber])
  @@index([periodId])
  @@index([partNumber])
  @@index([date])
  @@map("hotlists")
}

// ============================================
// STOCK RAW MATERIAL
// ============================================

model StockRawMaterial {
  id        String   @id @default(cuid())
  periodId  String // periode UPLOAD (bukan tanggal di dalam data)
  itemDesc  String
  date      DateTime @db.Date
  supplier  String?
  qty       Float
  unit      String
  // Referensi customer/PO dari kolom Excel `Ref_B_PO`. Field SERAGAM untuk kedua
  // jenis data (Stock Raw Material & Outstanding PO). Hanya baris yang nilainya
  // mengandung "MTL" yang boleh masuk (lihat lib/excelRef.ts).
  refB      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  period PlanningCycle @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([periodId])
  @@index([date])
  @@index([periodId, itemDesc, supplier])
  @@index([periodId, refB])
  @@map("stock_raw_materials")
}

// ============================================
// OUTSTANDING PO
// ============================================

model OutstandingPO {
  id               String   @id @default(cuid())
  periodId         String // periode UPLOAD (bukan tanggal di dalam data)
  // Nomor PO dari kolom `PO NO` file Excel. WAJIB diisi (mandatory).
  // TIDAK unik: satu nomor PO boleh dipakai beberapa baris/item.
  poNumber         String
  planReceivedDate DateTime @db.Date
  supplierName     String
  itemDesc         String
  qtyOrder         Float
  qtyOrderUnit     String // "kg", "rim", "sheets"
  qtyDelivered     Float
  qtyDeliveredUnit String // "kg", "rim", "sheets"
  // Referensi customer/PO dari kolom Excel `PR Ref-B`. Field SERAGAM untuk kedua
  // jenis data (Outstanding PO & Stock Raw Material). Hanya baris yang nilainya
  // mengandung "MTL" yang boleh masuk (lihat lib/excelRef.ts).
  refB             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  period PlanningCycle @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([periodId])
  @@index([planReceivedDate])
  @@index([periodId, itemDesc, supplierName])
  @@index([periodId, poNumber])
  @@index([periodId, refB])
  @@map("outstanding_pos")
}

// ============================================
// NPOF MATERIALS
// ============================================

model NpofMaterial {
  id              String    @id @default(cuid())
  npofId          Int
  partNumber      String
  productName     String
  material        String?
  gramatur        String?
  supplier        String?
  sheetedSize     String?
  formulaMaterial String?   @db.Text
  ups             String?
  isEdited        Boolean   @default(false)
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([npofId, partNumber])
  @@index([npofId])
  @@index([partNumber])
  @@map("npof_materials")
}

// Immutable monthly snapshots of material calculations and their source data.
model CalculationHistory {
  id              String   @id @default(cuid())
  monthKey        String // YYYY-MM folder key
  periodStartDate DateTime @db.Date
  periodEndDate   DateTime @db.Date
  periodWeeks     Int
  calculatedAt    DateTime
  savedAt         DateTime @default(now())
  savedBy         String
  resultSnapshot  Json

  user    User                        @relation(fields: [savedBy], references: [id])
  sources CalculationSourceSnapshot[]

  @@index([monthKey])
  @@index([savedAt])
  @@map("calculation_histories")
}

model CalculationSourceSnapshot {
  id           String   @id @default(cuid())
  historyId    String
  sourceType   String // MRP, NPOF, StockRawMaterial, WIP, HOTLIST, OutstandingPO
  dataSnapshot Json
  createdAt    DateTime @default(now())

  history CalculationHistory @relation(fields: [historyId], references: [id], onDelete: Cascade)

  @@unique([historyId, sourceType])
  @@index([sourceType])
  @@map("calculation_source_snapshots")
}

// ============================================
// PLANNING CYCLE (Periode Data)
// ============================================
// Satu cycle = satu periode bulanan yang TERISOLASI penuh dari cycle lain.
//
// Sejak 2026-09-28, TIDAK ADA lagi tabel snapshot Cycle*: tabel Master Data
// (weekly_schedules, wips, hotlists, stock_raw_materials, outstanding_pos)
// menjadi penyimpanan data periode lewat kolom `periodId`.
// Aturannya sama seperti sebelumnya, hanya pindah tabel:
//   - `periodId` NOT NULL di semua tabel data periode
//   - semua @@unique SELALU diawali `periodId`
//   - overwrite = deleteMany({ where: { periodId } }) lalu insert
// Tabel di bawah ini hanya berisi METADATA periode + hasil perhitungan.

enum CycleStatus {
  DRAFT // data sedang disiapkan, belum dihitung
  CALCULATED // minimal sudah dihitung sekali (TETAP boleh diedit)
}

/// Jenis kolam material: lot stok raw material atau baris Outstanding PO.
enum MaterialPoolKind {
  STOCK
  PO
}

model PlanningCycle {
  id String @id @default(cuid())

  // ── Identitas BERBASIS BATCH UPLOAD, bukan tanggal di dalam data ──
  uploadMonth String // "2026-09" — otomatis dari waktu upload
  label       String      @unique // "September 2026" — otomatis, bisa diedit
  status      CycleStatus @default(DRAFT)

  // ── Metadata deskriptif dari file MRP (untuk tampilan & perhitungan) ──
  // Optional: periode bisa dibuat dari upload Stock/PO/Hotlist/WIP saja,
  // tanpa file MRP. Diisi/diperbarui saat MRP diupload.
  mrpStartDate DateTime? @db.Date
  mrpEndDate   DateTime? @db.Date
  weekCount    Int       @default(26)

  // ── Jejak waktu ──
  firstUploadedAt    DateTime  @default(now())
  lastUploadedAt     DateTime  @default(now())
  lastDataChangeAt   DateTime  @default(now())
  calculatedAt       DateTime?
  calculatedBy       String?
  calculatedRunCount Int       @default(0)

  // ── Kunci manual (opsional, default OFF) ──
  isLocked Boolean   @default(false)
  lockedAt DateTime?
  lockedBy String?
  lockNote String?   @db.Text

  // ── Retensi 18 bulan ──
  retentionDueAt      DateTime?
  retentionNotifiedAt DateTime?

  notes     String?  @db.Text
  createdAt DateTime @default(now())
  createdBy String

  // ── Data Master Data milik periode ini (langsung, BUKAN snapshot) ──
  weeklySchedules WeeklySchedule[]
  hotlists        Hotlist[]
  stocks          StockRawMaterial[]
  pos             OutstandingPO[]
  wips            WIP[]

  uploads   CycleSourceUpload[]
  results   CycleResult[]
  auditLogs CycleAuditLog[]
  exclusions MaterialCalcExclusion[]
  // Catatan: TIDAK ada relasi ke NPOF — dipakai bersama semua periode.

  @@unique([uploadMonth])
  @@index([status])
  @@index([createdAt])
  @@map("planning_cycles")
}

// Jejak setiap upload (menjawab "kapan data diupload").
model CycleSourceUpload {
  id         String   @id @default(cuid())
  cycleId    String
  sourceType String // MRP | HOTLIST | STOCK_RM | OUTSTANDING_PO | WIP
  fileName   String?
  rowCount   Int      @default(0)
  mode       String? // replace | append (hanya di dalam cycle ini)
  uploadedAt DateTime @default(now())
  uploadedBy String

  cycle PlanningCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([cycleId, sourceType])
  @@index([uploadedAt])
  @@map("cycle_source_uploads")
}

// CATATAN (2026-09-28): model snapshot CycleMRPWeek / CycleHotlist / CycleStockRM /
// CycleOutstandingPO / CycleWIP SUDAH DIHAPUS. Sejak periode dipindahkan ke Master
// Data (`periodId` di weekly_schedules / hotlists / stock_raw_materials /
// outstanding_pos / wips), tabel snapshot menjadi duplikasi dan tidak lagi dipakai.
// Data periode kini dibaca LANGSUNG dari tabel Master Data dengan filter periodId.

// Hasil kalkulasi: SATU BARIS PER RUN (mendukung simpan versi).
model CycleResult {
  id              String   @id @default(cuid())
  cycleId         String
  runNumber       Int
  periodStartDate DateTime @db.Date
  periodEndDate   DateTime @db.Date
  periodWeeks     Int
  calculatedAt    DateTime
  calculatedBy    String
  /// Nilai PlanningCycle.lastDataChangeAt saat perhitungan dijalankan.
  /// Kalau lastDataChangeAt > dataVersionAt berarti hasil sudah STALE.
  dataVersionAt   DateTime

  /// Tepat satu baris per periode yang isCurrent = true.
  isCurrent Boolean @default(false)
  /// isSaved = true -> baris ini TIDAK dihapus saat ada perhitungan baru.
  isSaved   Boolean @default(false)
  savedNote String? @db.Text

  resultSnapshot  Json // groups + weeklyMatrix 26 kolom
  summarySnapshot Json?

  /// Checksum (snapshot ringkas) data master PER SUMBER tepat saat perhitungan
  /// dijalankan: { rows, sum, lastUpdatedAt }. Dipakai untuk mendeteksi
  /// "Calculation tidak valid karena ada perubahan data" ketika folder periode
  /// dibuka kembali — tanpa perlu menyimpan seluruh isi data master.
  dataSignature Json?

  cycle PlanningCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([cycleId, runNumber])
  @@index([cycleId, isCurrent])
  @@index([cycleId, isSaved])
  @@map("cycle_results")
}

// Jejak perubahan di dalam periode (siapa mengubah apa).
model CycleAuditLog {
  id         String      @id @default(cuid())
  cycleId    String
  userId     String
  action     AuditAction
  sourceType String? // MRP | HOTLIST | STOCK_RM | OUTSTANDING_PO | WIP | CYCLE
  entityType String
  entityId   String?
  dataBefore Json?
  dataAfter  Json?
  notes      String?     @db.Text
  createdAt  DateTime    @default(now())

  cycle PlanningCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id])

  @@index([cycleId, createdAt])
  @@index([cycleId, sourceType])
  @@index([userId])
  @@map("cycle_audit_logs")
}

/// Material dari kolam (lot stok / baris Outstanding PO) yang DIKELUARKAN user
/// dari perhitungan SATU ukuran (grup) tertentu.
///
/// Dipakai ketika sebuah material sebenarnya TIDAK ikut dalam perhitungan ukuran
/// ini — mis. karena ukurannya hanya kelipatan (117 cm untuk 58,5 cm) atau karena
/// material itu sudah dipakai ukuran lain. Selama baris ini ada, pool item
/// tersebut DILEWATI untuk grup itu, sehingga otomatis jadi tersedia bagi grup
/// lain (alokasi dijalankan ulang oleh endpoint-nya).
///
/// Berlaku PER PERIODE (periode terisolasi). MENGHAPUS baris = memakai material
/// itu lagi untuk grup tersebut — jalur "kembalikan".
model MaterialCalcExclusion {
  id      String           @id @default(cuid())
  cycleId String
  kind    MaterialPoolKind

  /// `${ukuran}||${gramatur}||${supplier}` — WAJIB sama dengan `groupKey` di
  /// materialCalcEngine.ts, kalau tidak pengecualian tidak akan terbaca.
  groupKey String

  /// Identitas pool item: STOCK = `${itemDesc}||${supplier}` (hasil agregasi lot),
  /// PO = `id` baris `outstanding_pos`.
  poolRef String

  /// Snapshot teks untuk tampilan & jejak audit — TIDAK dipakai perhitungan.
  groupLabel String
  poolLabel  String

  /// Jumlah yang DIKELUARKAN dari ukuran ini — hanya untuk pengecualian
  /// SEBAGIAN (2026-10-15): user boleh memakai sebagian qty lot/PO, sisanya
  /// dikeluarkan dari ukuran ini agar bisa dipakai ukuran lain.
  /// NULL / 0 = seluruh pool item dikeluarkan (perilaku lama).
  qty Float?

  /// Satuan `qty`: `kg` (bagian bersatuan kg) atau `sheet` (bagian lembar).
  unit String?

  /// Alasan user (wajib diisi lewat UI, boleh kosong dari API).
  reason    String?   @db.Text
  createdBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  cycle PlanningCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([cycleId, kind, groupKey, poolRef])
  @@index([cycleId, groupKey])
  @@map("material_calc_exclusions")
}

// ============================================
// PRINTING (KBA) — modul Printing Planning
// ============================================
// Diintegrasikan dari aplikasi Printing Planning (repo Production-Planning).
// Spesifikasi mesin (warna, tinta spesial, ukuran min/max) ada di kode
// `packages/shared/src/printing/machines.ts`; tabel ini hanya menyimpan
// kapasitas yang boleh diubah planner.
//
// Semua waktu printing adalah JAM DINDING WIB yang disimpan apa adanya
// (07:00 WIB disimpan 07:00:00, tanpa konversi zona) — sama dengan engine
// planning yang mengolah jam pabrik sebagai UTC agar tidak bergeser.

/// Mesin cetak dan kapasitasnya. `id` = id di PLANNING_MACHINES (kba1..kba4, genius).
model PrintingMachine {
  id             String   @id @db.VarChar(20)
  name           String   @db.VarChar(40)
  /// Ribu lembar per jam (kolom "unit/hour" GC PRINTING).
  speed          Float
  /// Jam setup per job.
  setupHours     Float    @default(1)
  /// Jam efektif per hari (24 jam − istirahat shift).
  effectiveHours Float    @default(22.5)
  /// Optimistic locking: PUT wajib mengirim versi yang sedang dilihat.
  version        Int      @default(1)
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  maintenance PrintingMaintenance[]

  @@map("printing_machines")
}

/// Shift pabrik dan istirahatnya. Disimpan sebagai SATU daftar: semua baris
/// berbagi `version`, dan PUT mengganti seluruh daftar sekaligus.
model PrintingShift {
  id         String   @id @default(cuid())
  sortOrder  Int
  name       String   @db.VarChar(40)
  /// "HH:MM"
  start      String   @db.VarChar(5)
  end        String   @db.VarChar(5)
  breakStart String   @db.VarChar(5)
  breakEnd   String   @db.VarChar(5)
  version    Int      @default(1)
  updatedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([sortOrder])
  @@map("printing_shifts")
}

/// Tanggal merah & hari libur pabrik. Setiap plan memilih sendiri apakah tetap
/// mencetak di hari ini (lihat `workdays` di kalender plan).
model PrintingHoliday {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  name      String   @db.VarChar(80)
  createdBy String?
  createdAt DateTime @default(now())

  @@map("printing_holidays")
}

/// Jendela maintenance mesin (jam dinding WIB). Planning tidak menaruh job yang
/// menabrak jendela ini; job digeser ke setelahnya.
model PrintingMaintenance {
  id        String   @id @default(cuid())
  machineId String   @db.VarChar(20)
  startAt   DateTime
  endAt     DateTime
  reason    String   @db.VarChar(200)
  version   Int      @default(1)
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  machine PrintingMachine @relation(fields: [machineId], references: [id], onDelete: Restrict)

  @@index([machineId, startAt])
  @@index([startAt])
  @@map("printing_maintenance")
}
