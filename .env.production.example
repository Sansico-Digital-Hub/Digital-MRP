# ============================================================================
# Contoh variabel environment untuk deploy di Dokploy.
#
# Cara pakai:
#   1. Salin isi file ini ke tab "Environment" di Dokploy, JANGAN commit
#      file .env yang sudah diisi.
#   2. Ganti SEMUA nilai yang bertanda <...>.
#   3. Nilai rahasia bisa dibuat dengan: openssl rand -base64 48
#
# Catatan: file .env asli sudah masuk .dockerignore sehingga tidak akan
# ikut terbawa ke dalam image.
# ============================================================================

# ---------- Database ----------
# Hanya dipakai kalau memakai service mysql di docker-compose.dokploy.yml.
# Gunakan `openssl rand -hex 24` (bukan -base64) agar karakter / + = tidak
# merusak URL koneksi di DATABASE_URL.
MYSQL_DATABASE=planner_project
MYSQL_USER=pdits
MYSQL_PASSWORD=<openssl-rand-hex-24>
MYSQL_ROOT_PASSWORD=<openssl-rand-hex-24>

# ---------- Redis ----------
# Redis kini memakai password karena jaringan dokploy-network dipakai bersama
# oleh semua project di server yang sama.
REDIS_PASSWORD=<openssl-rand-hex-24>

# ---------- Keamanan ----------
# WAJIB diganti. Kalau kosong ATAU kurang dari 32 karakter, API MENOLAK START
# saat NODE_ENV=production (lihat apps/api/src/config/index.ts).
# Keduanya harus BERBEDA satu sama lain.
JWT_SECRET=<openssl-rand-base64-48>
JWT_REFRESH_SECRET=<openssl-rand-base64-48-lagi>

# ---------- Domain ----------
# Domain web yang dipakai karyawan, tanpa garis miring di akhir.
# Harus sama dengan domain web agar tidak diblokir CORS.
# Boleh lebih dari satu domain, dipisah koma.
CORS_ORIGIN=https://<domain-web-anda>
FRONTEND_URL=https://<domain-web-anda>

# Alamat publik API. Dipakai DUA kali:
#   1. VITE_API_URL -> ditanam ke bundle frontend saat build
#   2. NPOF_API_URL -> alamat layanan NPOF eksternal
VITE_API_URL=https://<domain-api-anda>/api/v1

# ---------- Akun admin pertama ----------
# Hanya dipakai saat tabel users masih kosong (database baru).
# Setelah berhasil login, ganti password lewat aplikasi.
ADMIN_EMAIL=<email-admin-anda>
ADMIN_PASSWORD=<password-kuat-minimal-8-karakter>

# ---------- Feature flag frontend ----------
# Diteruskan sebagai build arg oleh services.web.build.args di
# docker-compose.dokploy.yml (lihat ARG di Dockerfile.web), jadi cukup diisi
# di tab Environment seperti variabel lain.
# false = menu Material Calculation disembunyikan (nilai aman untuk awal deploy)
# true  = menu ditampilkan
VITE_ENABLE_MATERIAL_CALC=false

# ---------- Batas upload ----------
# Ukuran maksimum satu file Excel yang di-upload, dalam MB.
# Batas nginx (client_max_body_size 60m) dan bodyLimit API (50MB) tetap berlaku
# sebagai batas luar.
MAX_UPLOAD_MB=20

# ---------- Notifikasi push (opsional) ----------
# Generate dengan: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:<email-admin-anda>

# ---------- Integrasi NPOF (opsional) ----------
# PENTING: jangan biarkan http://127.0.0.1:8008 di server, karena di dalam
# container alamat itu menunjuk ke container itu sendiri. Isi URL nyata
# layanan NPOF, atau kosongkan kalau fiturnya belum dipakai.
NPOF_API_URL=
NPOF_API_KEY=

# ---------- Penyetelan perhitungan material (opsional) ----------
# Toleransi ukuran saat mencocokkan stok ke kebutuhan, dalam cm.
MATERIAL_SIZE_TOLERANCE_CM=2
# 1 rim dianggap berapa lembar.
SHEETS_PER_RIM=500
# true (DEFAULT sejak 2026-10-15) = supplier wajib sama saat mencocokkan stok/PO
# ke satu ukuran (spesifikasi §2: NPOF dihubungkan ke Stok/PO lewat Item Desc +
# Supplier). Nama supplier dinormalisasi dulu (PHIL CORPORATION = HANCHANG,
# PT. MEGA SURYA ERATAMA = MEGA), dan supplier yang DATANYA KOSONG ("-"/kosong)
# tetap boleh memakai material apa pun.
# false = kembali ke perilaku lama: hanya gramatur + ukuran yang menentukan.
MATERIAL_REQUIRE_SUPPLIER=true
