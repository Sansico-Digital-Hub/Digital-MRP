# Database
DATABASE_URL=mysql://user:password@localhost:3306/pdits
DEBUG_DB=false

# Redis
REDIS_URL=redis://:password@localhost:6379
DISABLE_REDIS=false

# JWT
# Saat NODE_ENV=production, keduanya WAJIB diisi, minimal 32 karakter, dan
# harus berbeda. Kalau tidak, API menolak start (lihat src/config/index.ts).
JWT_SECRET=your-jwt-secret-key-min-64-characters-long-for-production
JWT_REFRESH_SECRET=your-refresh-secret-key-min-64-characters-long-for-production
JWT_ACCESS_EXPIRY=5h
JWT_REFRESH_EXPIRY=7d

# Web Push (VAPID)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@yourdomain.com

# App Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# CORS
CORS_ORIGIN=http://localhost:5173

# Integrasi NPOF (opsional)
# Di server/VPS JANGAN biarkan 127.0.0.1, karena di dalam container alamat itu
# menunjuk ke container itu sendiri.
NPOF_API_URL=http://127.0.0.1:8008
NPOF_API_KEY=

# Akun SUPER_ADMIN pertama (opsional)
# Hanya dipakai saat tabel users masih kosong, misalnya pada database baru.
# Lihat apps/api/src/lib/bootstrapAdmin.ts
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Penyetelan perhitungan material (opsional)
# Toleransi ukuran saat mencocokkan stok ke kebutuhan, dalam cm.
MATERIAL_SIZE_TOLERANCE_CM=2
# 1 rim dianggap berapa lembar.
SHEETS_PER_RIM=500
# true (DEFAULT sejak 2026-10-15) = supplier wajib sama saat mencocokkan stok/PO
# ke satu ukuran (spesifikasi §2: NPOF dihubungkan ke Stock Raw Material dan
# Outstanding PO lewat Item Desc + Supplier). Nama supplier dinormalisasi dulu
# (PHIL CORPORATION = HANCHANG, PT. MEGA SURYA ERATAMA = MEGA), dan supplier yang
# DATANYA KOSONG ("-"/kosong/"Unknown") tetap boleh memakai material apa pun.
# false = kembali ke perilaku lama: hanya gramatur + ukuran yang menentukan.
MATERIAL_REQUIRE_SUPPLIER=true
# Rekomendasi ukuran material + estimasi waste (INFORMASI; tidak mengubah angka
# perhitungan). Jumlah alternatif ukuran per grup & kelipatan maksimum yang diuji.
MATERIAL_REC_MAX_OPTIONS=8
MATERIAL_REC_MAX_MULTIPLIER=6
# Sertakan ukuran dari NPOF yang belum ada di stok/PO.
MATERIAL_REC_INCLUDE_NPOF=true
# Ukuran standar (cm) yang selalu dipertimbangkan, dipisah koma.
MATERIAL_REC_STANDARD_SIZES=180

# Alamat API untuk frontend (dipakai saat build frontend, bukan runtime)
VITE_API_URL=http://localhost:3001/api/v1

# Batas ukuran satu file Excel yang di-upload, dalam MB (default 20).
MAX_UPLOAD_MB=20

# Feature flag frontend (dibaca SAAT BUILD, bukan runtime)
# true  = menu Material Calculation muncul
# false = menu disembunyikan dan URL-nya dialihkan ke dashboard
VITE_ENABLE_MATERIAL_CALC=false
